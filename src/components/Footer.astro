  >
    <div class="mt-8 md:mt-0 md:order-1">
      <p class="text-base text-gray-400">
        © Bản quyền gốc thuộc về <a
          class="text-indigo-500 font-semibold"
          href={site.grind75Url}>Tech Interview Handbook - Grind75.</a
        >
      </p>
      <p class="text-base text-gray-400">
        ❤️ Việt Hoá bởi <a
          class="text-indigo-500 font-semibold"
          href={site.youtubeUrl}>Tôi Đi Code Dạo</a
        >.
      </p>
    </div>
  </div>
</footer>
