            publisher: { "@id": "https://300baicode.com/#person" },
          },
          {
            "@type": "Person",
            "@id": "https://300baicode.com/#person",
            name: "Hoàng Phạm (Tôi Đi Code Dạo)",
            url: "https://toidicodedao.com",
            sameAs: ["https://bit.ly/codedaotube"],
          },
          {
            "@type": "WebPage",
            "@id": "https://300baicode.com/#webpage",
            url: "https://300baicode.com/",
            name: "300 Bài Code Thiếu Nhi - Luyện code phỏng vấn FAANG theo Grind 75",
