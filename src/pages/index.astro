---
import Layout from "../layouts/Layout.astro";
import Header from "../components/Header.astro";
import Footer from "../components/Footer.astro";
import TestimonialsColumn from "../components/TestimonialsColumn.astro";
import IntroHero from "../components/IntroHero.astro";
import IntroOverview from "../components/IntroOverview.astro";
import WeekSection from "../components/WeekSection.astro";
import { weeks } from "../data/problems";
---

<Layout>
  <Header />

  <main class="space-y-12 bg-white pb-12">
    <div class="mx-auto border-y border-gray-300 bg-gray-50">
      <div class="flex-grow w-full lg:flex">
        <div class="flex-1 min-w-0 xl:flex">
          <div class="lg:min-w-0 lg:flex-1 md:flex">
            <TestimonialsColumn />

            <div class="h-full py-6 px-4 sm:px-6 lg:px-8 md:order-1 grow">
              <div class="flex h-full items-center justify-center">
                <div class="space-y-4">
                  <IntroHero />
                  <div>
                    <IntroOverview />

                    <div class="bg-gray-50 top-0 py-4 z-10">
                      <div class="space-y-4">
                        {weeks.map((week) => <WeekSection week={week} />)}
                      </div>
                    </div>
                  </div>
                </div>
              </div>
            </div>
          </div>
        </div>
      </div>
    </div>

    <Footer />
  </main>
</Layout>
