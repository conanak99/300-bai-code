      property="og:description"
      content="Luyện 300 bài code thiếu nhi (phiên bản Việt hoá Grind 75) để chuẩn bị phỏng vấn lập trình tại các công ty lớn như FAANG."
    />
    <meta property="og:image" content={`https://300baicode.com${bookCover.src}`} />
    <meta property="og:image:width" content={String(bookCover.width)} />
    <meta property="og:image:height" content={String(bookCover.height)} />
    <meta property="og:image:alt" content="Bìa sách 300 Bài Code Thiếu Nhi" />
    <meta property="og:locale" content="vi_VN" />

    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content="300 Bài Code Thiếu Nhi - Phiên bản Việt hoá Grind 75" />
    <meta name="twitter:description" content="Luyện 300 bài code thiếu nhi để chuẩn bị phỏng vấn lập trình tại các công ty lớn như FAANG." />
    <meta name="twitter:image" content={`https://300baicode.com${bookCover.src}`} />

    <meta property="fb:app_id" content="1955312427813371" />

    <script
      type="application/ld+json"
      set:html={JSON.stringify({
        "@context": "https://schema.org",
        "@graph": [
          {
            "@type": "WebSite",
            "@id": "https://300baicode.com/#website",
            url: "https://300baicode.com/",
            name: "300 Bài Code Thiếu Nhi",
            inLanguage: "vi-VN",
            description:
