---
import { Image } from "astro:assets";

import bookCover from "../assets/images/book_cover.png";

import image1 from "../assets/images/1.jpg";
import image2 from "../assets/images/2.jpg";
import image3 from "../assets/images/3.webp";
import image4 from "../assets/images/4.jpg";
import image5 from "../assets/images/5.jpg";
import image6 from "../assets/images/6.jpg";
import image7 from "../assets/images/7.webp";
import image8 from "../assets/images/8.jpg";
import image9 from "../assets/images/9.jpg";
import image10 from "../assets/images/10.jpg";
---

<!doctype html>
<html lang="vi">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>300 Bài Code Thiếu Nhi - Luyện code phỏng vấn FAANG theo Grind 75</title>
    <meta
      name="description"
      content="Luyện 300 bài code thiếu nhi (phiên bản Việt hoá Grind 75) để chuẩn bị phỏng vấn lập trình tại các công ty lớn như FAANG. Lộ trình 1-4 tháng, chia theo tuần, dễ theo dõi."
    />
    <meta name="author" content="Tôi Đi Code Dạo (Hoàng Phạm) - Parody of Tech Interview Handbook" />
    <meta name="robots" content="index, follow, max-image-preview:large, max-snippet:-1, max-video-preview:-1" />
    <meta name="keywords" content="300 bài code thiếu nhi, grind 75, luyện code phỏng vấn, leetcode tiếng việt, phỏng vấn lập trình, FAANG, thuật toán, toi di code dao" />
    <meta name="theme-color" content="#4f46e5" />
    <link rel="canonical" href="https://300baicode.com/" />

