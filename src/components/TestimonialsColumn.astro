---
import { Image } from "astro:assets";

import { site } from "../data/site";
import { testimonials } from "../data/testimonials";
---

<aside class="block order-2 xs:w-screen md:w-1/3 shrink-0">
  <div class="md:top-0">
    <div>
      <h2
        class="block py-6 px-4 sm:px-6 lg:px-8 font-semibold text-xl text-white transition bg-black"
      >
        Những người đã đổi đời nhờ 300 Bài Code Thiếu Nhi👇
      </h2>
      {
        testimonials.map((t, i) => (
          <p class={`flex text-sm text-white transition ${t.bg}`}>
            <Image
              class="object-cover w-36 mx-auto"
              src={t.image}
              width={300}
              height={400}
              alt={t.alt}
              loading={i === 0 ? "eager" : "lazy"}
              decoding="async"
              {...(i === 0 ? { fetchpriority: "high" } : {})}
            />
            <span
              class="py-5 px-4 sm:px-6 lg:px-8 text-justify"
              set:html={t.html}
            />
          </p>
        ))
      }
      <div class="block py-6 px-2 sm:px-4 lg:px-6 bg-white">
        <h2 class="font-semibold text-xl text-black mb-4">
          Comment của bạn đọc👇
        </h2>
        <div
          class="fb-comments"
          data-href={`${site.url}`}
          data-width="100%"
          data-numposts="10"
        >
        </div>
      </div>
    </div>
  </div>
</aside>
