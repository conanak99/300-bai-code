      <div class="mx-auto border-y border-gray-300 bg-gray-50">
        <div class="flex-grow w-full lg:flex">
          <div class="flex-1 min-w-0 xl:flex">
            <div class="lg:min-w-0 lg:flex-1 md:flex">
